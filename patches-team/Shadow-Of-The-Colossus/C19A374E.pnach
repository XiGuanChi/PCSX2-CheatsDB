gametitle=Shadow of the Colossus NTSC-U SCUS-97472

// Shadow of the Colossus - Graphics/Visual Tweak Patches
// Author: Google

// ============================================================
//  DISABLE SUN
// ============================================================

[By manipulating the Setter function to assign value 0 via $v1 to the control address,
// which receives the 4-byte constant 0-value: 01286410 00000000]
patch=1,EE,0119baa8,word,3C020128
patch=1,EE,0119baac,word,24030000
patch=1,EE,0119bab0,word,03E00008
patch=1,EE,0119bab4,word,AC436410

[By manipulating the Getter function to assign value 0 to register $a0]
patch=1,EE,0119ba50,word,24040000

[By setting the inconspicuous constant activator value from 1 to 0, and also setting
//  the sun intensity value adder register $a2 to 0, to finally place both zeros
//  (fake sum) into register $s0]
patch=1,EE,01198c08,word,24100000

[Return early with no operation]
patch=1,EE,0119ba48,word,03e00008
patch=1,EE,0119ba4c,word,00000000

